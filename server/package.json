{
  "name": "dai-kody-server",
  "version": "0.1.0",
  "private": true,
  "description": "dAI (Kody) API - Express, MySQL, Socket.IO",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/server.js",
    "dev": "node --env-file-if-exists=../.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=../.env scripts/migrate.js",
    "migrate:status": "node --env-file-if-exists=../.env scripts/migrate.js --status",
    "migrate:fresh": "node --env-file-if-exists=../.env scripts/migrate.js --fresh",
    "import:codes": "node --env-file-if-exists=../.env scripts/import-codes.js",
    "digest": "node --env-file-if-exists=../.env scripts/send-digests.js",
    "test": "node --env-file-if-exists=../.env --test --test-concurrency=1 tests/*.test.js",
    "seed:passwords": "node --env-file-if-exists=../.env scripts/seed-passwords.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.14.0",
    "pdfkit": "^0.17.1",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
