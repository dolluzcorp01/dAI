{
  "manifest_version": 3,
  "name": "Kody by Dolluz",
  "short_name": "Kody",
  "version": "0.9.0",
  "description": "Your work companion. Ask about denials, codes, payer rules and more, on any page.",

  "minimum_chrome_version": "114",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_title": "Kody",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "https://accounts.google.com/*",
        "https://login.microsoftonline.com/*",
        "https://*.bank/*"
      ],
      "js": ["src/content/bubble.js"],
      "css": ["src/content/bubble.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "contextMenus",
    "notifications"
  ],

  "optional_permissions": [
    "identity"
  ],

  "optional_host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "host_permissions": [
    "https://dai.dolluzcorp.com/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-ancestors 'none'"
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/icon-32.png", "icons/icon-128.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],

  "commands": {
    "toggle-kody": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open or close Kody"
    },
    "ask-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Ask Kody about the selected text"
    }
  }
}
