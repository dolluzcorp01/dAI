# dAI (Kody) - environment template. Copy to .env (repo root). NEVER commit .env.
# server/src/config.js is the only file that reads the environment.
# The dAdmin link keys are added to config.js in Phase 1; everything else is read today.

NODE_ENV=development
PORT=4014
PUBLIC_URL=http://localhost:4014
WEB_URL=http://localhost:3000

# --- database (MySQL 8) ------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kody
DB_USER=kody
DB_PASSWORD=
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# --- auth --------------------------------------------------------------
# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
AUTH_CODE_TTL_SECONDS=60
ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback
# Tests only: auth.test.js redeems handoff codes against this; it must be one of ALLOWED_REDIRECT_URIS.
TEST_REDIRECT=http://localhost:3000/auth/callback
# Chrome extension ids (32 letters a-p), comma separated. Never a wildcard.
EXTENSION_IDS=

# --- dAdmin link (Phase 1, not read until Phase 1 lands) -------------
# Same MySQL server. The dAI DB user needs SELECT on dadmin.employee only.
DADMIN_DB_NAME=dadmin
# dAdmin's JWT_SECRET, used only to verify dAdmin -> dAI admin calls.
DADMIN_SHARED_JWT_SECRET=

# --- model gateway -----------------------------------------------------
MODEL_PRIMARY_PROVIDER=anthropic
MODEL_FALLBACK_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL_TIER1=claude-haiku-4-5
MODEL_TIER2=claude-sonnet-5
MODEL_TIER3=claude-opus-5
MODEL_MAX_RETRIES=2
MODEL_MAX_TOKENS=1500
MODEL_WEB_SEARCH=false
KODY_RATE_MAX=30

# --- files -------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./var/uploads
MAX_FILE_MB=25
SPACES_ENDPOINT=
SPACES_BUCKET=
SPACES_REGION=blr1
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
FILE_SCANNER=local
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- mail and push -----------------------------------------------------
MAIL_DRIVER=memory
MAIL_FROM=kody@dolluzcorp.com
SENDGRID_API_KEY=
PUSH_DRIVER=memory
FCM_SERVER_KEY=

# --- realtime ----------------------------------------------------------
# Empty = single instance. Required in production.
REDIS_URL=
SOCKET_PATH=/socket.io
